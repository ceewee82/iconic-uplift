---
// Stilisierte Karte der drei Zielgebiete. Spec: DEV_SPEC §4 Zeile 10 —
// Pfade zeichnen sich (stroke-dashoffset), Punkte poppen.
//
// Reduziert, aber wiedererkennbar: Küstenlinie, Palm Jumeirah mit Sichel
// und Wedeln, Sheikh Zayed Road als Orientierungsachse. Die Palme ist
// geometrisch durchgerechnet — Stamm sitzt auf der Küste, alle Wedel
// liegen innerhalb der Sichel (Radius 140 um den Wedel-Mittelpunkt).
---

<div class="map">
  <svg
    viewBox="0 0 900 600"
    class="map-svg"
    role="img"
    aria-label="Stilisierte Karte des westlichen Dubai: Küstenlinie, Palm Jumeirah und Sheikh Zayed Road. Markiert sind die drei Zielgebiete Palm Jumeirah, Jumeirah Islands und Emirates Living."
  >
    <!-- Meer: alles nordwestlich der Küste. Küste und Straße laufen bewusst
         über den Rahmen hinaus, damit sie an beiden Rändern durchgehen. -->
    <path class="map-sea" d="M -40 626 C 200 468 480 262 940 -14 L 940 -40 L -40 -40 Z" />

    <g class="map-waves">
      <path d="M 70 300 C 110 292 150 284 190 276" />
      <path d="M 120 410 C 160 402 200 394 240 386" />
      <path d="M 560 120 C 600 112 640 104 680 96" />
    </g>

    <path class="map-line map-coast" fill="none" d="M -40 626 C 200 468 480 262 940 -14" />

    <!-- Sheikh Zayed Road, durchgehend landeinwärts (37–73 px Abstand) -->
    <path class="map-line map-road" fill="none"
      d="M -40 700 C 200 540 470 350 600 258 C 730 166 830 96 940 20" />

    <!-- ---------- Palm Jumeirah ----------
         Sichelmittelpunkt 188 px von der Küste bei Radius 152 — die Insel
         liegt vollständig im Wasser, nur der Stamm berührt Land. -->
    <g class="palm">
      <path class="map-line palm-crescent" fill="none" d="M 292 333 A 152 152 0 1 1 418 248" />
      <path class="map-line palm-trunk" fill="none" d="M 387 337 L 203 64" />

      <g class="palm-fronds">
        <path class="map-line" d="M 350 283 L 423 207" />
        <path class="map-line" d="M 350 283 L 252 322" />
        <path class="map-line" d="M 328 250 L 416 130" />
        <path class="map-line" d="M 328 250 L 183 285" />
        <path class="map-line" d="M 306 217 L 381 77" />
        <path class="map-line" d="M 306 217 L 148 233" />
        <path class="map-line" d="M 284 184 L 334 47" />
        <path class="map-line" d="M 284 184 L 138 179" />
        <path class="map-line" d="M 262 151 L 286 38" />
        <path class="map-line" d="M 262 151 L 148 131" />
        <path class="map-line" d="M 240 119 L 246 43" />
        <path class="map-line" d="M 240 119 L 168 95" />
      </g>
    </g>

    <!-- The World Islands -->
    <g class="map-islands">
      <circle cx="658" cy="117" r="3.1" />
      <circle cx="659" cy="115" r="2.6" />
      <circle cx="717" cy="130" r="2.6" />
      <circle cx="706" cy="99" r="2.2" />
      <circle cx="744" cy="125" r="2.7" />
      <circle cx="756" cy="118" r="3.1" />
      <circle cx="674" cy="90" r="1.9" />
      <circle cx="743" cy="112" r="1.8" />
      <circle cx="711" cy="125" r="1.7" />
      <circle cx="661" cy="115" r="3.0" />
      <circle cx="653" cy="107" r="2.4" />
      <circle cx="679" cy="92" r="2.1" />
      <circle cx="758" cy="110" r="3.0" />
      <circle cx="691" cy="93" r="2.0" />
      <circle cx="695" cy="120" r="2.8" />
      <circle cx="657" cy="126" r="2.3" />
      <circle cx="752" cy="103" r="1.7" />
      <circle cx="714" cy="138" r="2.4" />
    </g>

    <!-- Dubai Marina als Turmgruppe an der Küste -->
    <g class="map-marina">
      <path d="M 150 512 L 150 490" />
      <path d="M 165 512 L 165 481" />
      <path d="M 180 512 L 180 486" />
      <path d="M 195 512 L 195 477" />
      <path d="M 210 512 L 210 488" />
      <path d="M 225 512 L 225 483" />
    </g>

    <!-- ---------- Zielgebiete ---------- -->
    <g class="map-leaders">
      <path class="leader" d="M 431 132 L 450 120" />
      <path class="leader" d="M 480 452 L 600 438" />
      <path class="leader" d="M 585 516 L 600 522" />
    </g>

    <g class="map-dots">
      <circle class="map-dot" cx="282" cy="181" r="7" />
      <circle class="map-dot" cx="470" cy="452" r="7" />
      <circle class="map-dot" cx="575" cy="516" r="7" />
    </g>

    <!-- Nummern verweisen auf die Karten darunter; nur mobil sichtbar,
         wo die ausgeschriebenen Labels zu klein würden. -->
    <g class="map-nums" aria-hidden="true">
      <text x="342" y="252">03</text>
      <text x="488" y="444">02</text>
      <text x="593" y="508">01</text>
    </g>

    <g class="map-labels">
      <text x="458" y="124">PALM JUMEIRAH</text>
      <text class="map-label-sub" x="458" y="144">Flagship &amp; Iconic</text>

      <text x="614" y="434">JUMEIRAH ISLANDS</text>
      <text class="map-label-sub" x="614" y="454">Signature-Terrain</text>

      <text x="614" y="518">EMIRATES LIVING</text>
      <text class="map-label-sub" x="614" y="538">Meadows · Lakes · Springs</text>
    </g>

    <g class="map-context">
      <text x="34" y="566">ARABISCHER GOLF</text>
      <text x="650" y="62">THE WORLD</text>
      <text x="242" y="506">DUBAI MARINA</text>
      <text class="map-context-road" x="470" y="404" transform="rotate(-38 470 404)">
        SHEIKH ZAYED ROAD
      </text>
    </g>
  </svg>
</div>

<style>
  .map {
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 1.25rem;
  }

  .map-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Wasserfläche minimal dunkler als das Land — genug, damit die
     Küstenlinie liest, ohne die Karte zweifarbig wirken zu lassen. */
  .map-sea {
    fill: #0a0a0b;
  }

  .map-waves path {
    fill: none;
    stroke: var(--color-line);
    stroke-width: 1;
    stroke-linecap: round;
    opacity: 0.7;
  }

  .map-line {
    stroke: var(--color-gold);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .map-coast {
    stroke-width: 1.8;
  }

  .palm-fronds .map-line {
    stroke-width: 1;
    stroke: var(--color-gold-light);
    opacity: 0.7;
  }

  /* Die Straße tritt zurück, sie dient nur der Orientierung */
  .map-road {
    stroke: var(--color-line);
    stroke-width: 2.5;
  }

  .map-islands circle {
    fill: none;
    stroke: var(--color-text-dim);
    stroke-width: 1;
    opacity: 0.55;
  }

  .map-marina path {
    fill: none;
    stroke: var(--color-text-dim);
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0.6;
  }

  .leader {
    fill: none;
    stroke: var(--color-line);
    stroke-width: 1;
  }

  .map-dot {
    fill: var(--color-black);
    stroke: var(--color-gold);
    stroke-width: 1.8;
  }

  .map-labels text {
    fill: var(--color-text);
    font-family: var(--font-display);
    font-size: 17px;
    letter-spacing: 2.6px;
  }

  .map-labels .map-label-sub {
    fill: var(--color-text-dim);
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.6px;
  }

  .map-context text {
    fill: var(--color-text-dim);
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 2.4px;
    opacity: 0.5;
  }

  /* Nummern: auf dem Desktop unsichtbar, dort stehen die vollen Labels */
  .map-nums text {
    fill: var(--color-gold-light);
    font-family: var(--font-display);
    font-size: 26px;
    letter-spacing: 1px;
    opacity: 0;
    /* Dunkle Kontur hinter der Schrift: Die Nummern sitzen zwangslaeufig
       nahe an Linien — so bleiben sie unabhaengig vom Untergrund lesbar. */
    paint-order: stroke;
    stroke: var(--color-black);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  /* Unter 768 px wird die Karte auf die Geografie beschnitten (siehe Script).
     Die ausgeschriebenen Labels waeren dort nur ~5 px hoch — statt sie
     unleserlich mitzuschleppen, uebernehmen die Nummern die Zuordnung
     zu den Gebietskarten darunter. */
  @media (max-width: 767px) {
    .map-labels,
    .map-leaders,
    .map-context {
      display: none;
    }

    .map-nums text {
      opacity: 1;
    }
  }

  .map-context .map-context-road {
    font-size: 10px;
    letter-spacing: 1.8px;
    opacity: 0.4;
  }
</style>

<script>
  // Linien zeichnen sich beim Eintritt, danach erscheinen Punkte und Labels.
  // Reine CSS-Transitions plus IntersectionObserver — kein GSAP nötig.
  const svg = document.querySelector<SVGSVGElement>('.map-svg');

  if (svg) {
    // Mobil auf die Geografie beschneiden: Die rechte Label-Spalte entfaellt,
    // dadurch wird der gezeichnete Teil deutlich groesser statt nur kleiner.
    const schmal = window.matchMedia('(max-width: 767px)');
    const setzeAusschnitt = () => {
      svg.setAttribute('viewBox', schmal.matches ? '0 0 660 600' : '0 0 900 600');
    };
    setzeAusschnitt();
    schmal.addEventListener('change', setzeAusschnitt);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lines = Array.from(svg.querySelectorAll<SVGPathElement>('.map-line'));
    const dots = Array.from(svg.querySelectorAll<SVGCircleElement>('.map-dot'));
    const leaders = Array.from(svg.querySelectorAll<SVGPathElement>('.leader'));
    const labels = svg.querySelector<SVGGElement>('.map-labels');
    const waves = svg.querySelector<SVGGElement>('.map-waves');

    if (!reduced) {
      lines.forEach((line) => {
        const length = line.getTotalLength();
        const lang = length > 300;
        line.style.strokeDasharray = String(length);
        line.style.strokeDashoffset = String(length);
        // Küste und Straße zeichnen länger, die kurzen Wedel folgen versetzt
        line.style.transition = `stroke-dashoffset ${lang ? 1.7 : 0.55}s ease-out ${
          lang ? 0 : 0.5
        }s`;
      });

      [waves, labels].forEach((el) => {
        if (!el) return;
        el.style.opacity = '0';
        el.style.transition = 'opacity 0.6s ease';
      });

      leaders.forEach((l) => {
        l.style.opacity = '0';
        l.style.transition = 'opacity 0.4s ease';
      });

      dots.forEach((dot) => {
        dot.style.opacity = '0';
        dot.style.transformOrigin = 'center';
        dot.style.transform = 'scale(0)';
        dot.style.transition =
          'transform 0.45s cubic-bezier(0.34, 1.4, 0.64, 1), opacity 0.3s ease';
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            observer.disconnect();

            lines.forEach((line) => {
              line.style.strokeDashoffset = '0';
            });
            if (waves) waves.style.opacity = '1';

            window.setTimeout(() => {
              leaders.forEach((l) => {
                l.style.opacity = '1';
              });
              if (labels) labels.style.opacity = '1';
            }, 1500);

            dots.forEach((dot, i) => {
              window.setTimeout(() => {
                dot.style.opacity = '1';
                dot.style.transform = 'scale(1)';
              }, 1300 + i * 150);
            });
          });
        },
        { threshold: 0.25 },
      );
      observer.observe(svg);
    }
  }
</script>
