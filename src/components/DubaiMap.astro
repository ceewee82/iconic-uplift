---
// Stilisierte Karte der drei Zielgebiete. Spec: DEV_SPEC §4 Zeile 10 —
// Pfade zeichnen sich (stroke-dashoffset), Punkte poppen.
//
// Reduziert, aber wiedererkennbar: Küstenlinie, Palm Jumeirah mit Sichel
// und Wedeln, Sheikh Zayed Road als Orientierungsachse. Die Palme ist
// geometrisch durchgerechnet — Stamm sitzt auf der Küste, alle Wedel
// liegen innerhalb der Sichel (Radius 140 um den Wedel-Mittelpunkt).
---

<div class="map">
  <svg
    viewBox="0 0 900 600"
    class="map-svg"
    role="img"
    aria-label="Stilisierte Karte des westlichen Dubai: Küstenlinie, Palm Jumeirah und Sheikh Zayed Road. Markiert sind die drei Zielgebiete Palm Jumeirah, Jumeirah Islands und Emirates Living."
  >
    <!-- Meer: alles nordwestlich der Küste -->
    <path
      class="map-sea"
      d="M 60 560 C 180 465 300 375 420 285 C 540 195 690 120 840 60 L 900 60 L 900 0 L 0 0 L 0 560 Z"
    />

    <!-- Angedeutete Wasserlinien, ersetzen eine flächige Einfärbung -->
    <g class="map-waves">
      <path d="M 78 300 C 118 292 158 284 198 276" />
      <path d="M 96 196 C 136 188 176 180 216 172" />
      <path d="M 470 128 C 510 120 550 112 590 104" />
      <path d="M 560 196 C 600 188 640 180 680 172" />
    </g>

    <!-- Küstenlinie -->
    <path
      class="map-line map-coast"
      fill="none"
      d="M 60 560 C 180 465 300 375 420 285 C 540 195 690 120 840 60"
    />

    <!-- Sheikh Zayed Road, Orientierungsachse im Landesinneren -->
    <path
      class="map-line map-road"
      fill="none"
      d="M 210 575 C 320 490 420 410 500 335 C 590 255 690 178 770 112"
    />

    <!-- ---------- Palm Jumeirah ---------- -->
    <!-- Liegt vollständig im Wasser; nur der Stamm berührt die Küste.
         Abstand Sichelmittelpunkt zur Küstenlinie: 129 px bei Radius 105. -->
    <g class="palm">
      <path class="map-line palm-crescent" fill="none" d="M 365 283 A 105 105 0 1 1 444 214" />
      <path class="map-line palm-trunk" fill="none" d="M 430 278 L 282 107" />

      <g class="palm-fronds">
        <path class="map-line" d="M 386 227 L 439 151" />
        <path class="map-line" d="M 386 227 L 303 269" />
        <path class="map-line" d="M 365 203 L 411 108" />
        <path class="map-line" d="M 365 203 L 264 235" />
        <path class="map-line" d="M 344 179 L 373 85" />
        <path class="map-line" d="M 344 179 L 247 194" />
        <path class="map-line" d="M 323 155 L 333 83" />
        <path class="map-line" d="M 323 155 L 250 155" />
        <path class="map-line" d="M 304 133 L 303 91" />
        <path class="map-line" d="M 304 133 L 262 126" />
      </g>
    </g>


    <!-- The World Islands, angedeutet als lockere Punktwolke -->
    <g class="map-islands">
        <circle cx="628" cy="131" r="2.5" />
        <circle cx="682" cy="129" r="2.1" />
        <circle cx="682" cy="127" r="1.7" />
        <circle cx="621" cy="123" r="1.7" />
        <circle cx="590" cy="132" r="1.8" />
        <circle cx="648" cy="145" r="2.9" />
        <circle cx="604" cy="108" r="3.0" />
        <circle cx="695" cy="127" r="2.0" />
        <circle cx="655" cy="129" r="2.0" />
        <circle cx="652" cy="103" r="2.4" />
        <circle cx="615" cy="101" r="2.4" />
        <circle cx="659" cy="122" r="1.9" />
        <circle cx="622" cy="97" r="2.0" />
        <circle cx="603" cy="106" r="2.0" />
        <circle cx="654" cy="90" r="1.9" />
        <circle cx="599" cy="107" r="2.8" />
        <circle cx="635" cy="99" r="3.0" />
        <circle cx="671" cy="133" r="2.7" />
    </g>

    <!-- Dubai Marina als Turmgruppe an der Küste -->
    <g class="map-marina">
        <path d="M 236 424 L 236 406" />
        <path d="M 249 424 L 249 398" />
        <path d="M 262 424 L 262 402" />
        <path d="M 275 424 L 275 394" />
        <path d="M 288 424 L 288 404" />
        <path d="M 301 424 L 301 400" />
    </g>

    <!-- ---------- Zielgebiete ---------- -->
    <g class="map-leaders">
      <path class="leader" d="M 452 182 L 600 200" />
      <path class="leader" d="M 400 470 L 600 442" />
      <path class="leader" d="M 490 512 L 600 528" />
    </g>

    <g class="map-dots">
      <circle class="map-dot" cx="345" cy="180" r="7" />
      <circle class="map-dot" cx="390" cy="470" r="7" />
      <circle class="map-dot" cx="480" cy="512" r="7" />
    </g>

    <g class="map-labels">
      <text x="614" y="196">PALM JUMEIRAH</text>
      <text class="map-label-sub" x="614" y="216">Flagship &amp; Iconic</text>

      <text x="614" y="438">JUMEIRAH ISLANDS</text>
      <text class="map-label-sub" x="614" y="458">Signature-Terrain</text>

      <text x="614" y="524">EMIRATES LIVING</text>
      <text class="map-label-sub" x="614" y="544">Meadows · Lakes · Springs</text>
    </g>

    <!-- Orientierung, bewusst zurückgenommen -->
    <g class="map-context">
      <text x="70" y="112">ARABISCHER GOLF</text>
      <text x="586" y="66">THE WORLD</text>
      <text x="252" y="454">DUBAI MARINA</text>
      <text class="map-context-road" x="516" y="352" transform="rotate(-40 516 352)">
        SHEIKH ZAYED ROAD
      </text>
    </g>
  </svg>
</div>

<style>
  .map {
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 1.25rem;
  }

  .map-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Wasserfläche minimal dunkler als das Land — genug, damit die
     Küstenlinie liest, ohne die Karte zweifarbig wirken zu lassen. */
  .map-sea {
    fill: #0a0a0b;
  }

  .map-waves path {
    fill: none;
    stroke: var(--color-line);
    stroke-width: 1;
    stroke-linecap: round;
    opacity: 0.7;
  }

  .map-line {
    stroke: var(--color-gold);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .map-coast {
    stroke-width: 1.8;
  }

  .palm-fronds .map-line {
    stroke-width: 1;
    stroke: var(--color-gold-light);
    opacity: 0.7;
  }

  /* Die Straße tritt zurück, sie dient nur der Orientierung */
  .map-road {
    stroke: var(--color-line);
    stroke-width: 2.5;
  }

  .map-islands circle {
    fill: none;
    stroke: var(--color-text-dim);
    stroke-width: 1;
    opacity: 0.55;
  }

  .map-marina path {
    fill: none;
    stroke: var(--color-text-dim);
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0.6;
  }

  .leader {
    fill: none;
    stroke: var(--color-line);
    stroke-width: 1;
  }

  .map-dot {
    fill: var(--color-black);
    stroke: var(--color-gold);
    stroke-width: 1.8;
  }

  .map-labels text {
    fill: var(--color-text);
    font-family: var(--font-display);
    font-size: 17px;
    letter-spacing: 2.6px;
  }

  .map-labels .map-label-sub {
    fill: var(--color-text-dim);
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.6px;
  }

  .map-context text {
    fill: var(--color-text-dim);
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 2.4px;
    opacity: 0.5;
  }

  .map-context .map-context-road {
    font-size: 10px;
    letter-spacing: 1.8px;
    opacity: 0.4;
  }
</style>

<script>
  // Linien zeichnen sich beim Eintritt, danach erscheinen Punkte und Labels.
  // Reine CSS-Transitions plus IntersectionObserver — kein GSAP nötig.
  const svg = document.querySelector<SVGSVGElement>('.map-svg');

  if (svg) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lines = Array.from(svg.querySelectorAll<SVGPathElement>('.map-line'));
    const dots = Array.from(svg.querySelectorAll<SVGCircleElement>('.map-dot'));
    const leaders = Array.from(svg.querySelectorAll<SVGPathElement>('.leader'));
    const labels = svg.querySelector<SVGGElement>('.map-labels');
    const waves = svg.querySelector<SVGGElement>('.map-waves');

    if (!reduced) {
      lines.forEach((line) => {
        const length = line.getTotalLength();
        const lang = length > 300;
        line.style.strokeDasharray = String(length);
        line.style.strokeDashoffset = String(length);
        // Küste und Straße zeichnen länger, die kurzen Wedel folgen versetzt
        line.style.transition = `stroke-dashoffset ${lang ? 1.7 : 0.55}s ease-out ${
          lang ? 0 : 0.5
        }s`;
      });

      [waves, labels].forEach((el) => {
        if (!el) return;
        el.style.opacity = '0';
        el.style.transition = 'opacity 0.6s ease';
      });

      leaders.forEach((l) => {
        l.style.opacity = '0';
        l.style.transition = 'opacity 0.4s ease';
      });

      dots.forEach((dot) => {
        dot.style.opacity = '0';
        dot.style.transformOrigin = 'center';
        dot.style.transform = 'scale(0)';
        dot.style.transition =
          'transform 0.45s cubic-bezier(0.34, 1.4, 0.64, 1), opacity 0.3s ease';
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            observer.disconnect();

            lines.forEach((line) => {
              line.style.strokeDashoffset = '0';
            });
            if (waves) waves.style.opacity = '1';

            window.setTimeout(() => {
              leaders.forEach((l) => {
                l.style.opacity = '1';
              });
              if (labels) labels.style.opacity = '1';
            }, 1500);

            dots.forEach((dot, i) => {
              window.setTimeout(() => {
                dot.style.opacity = '1';
                dot.style.transform = 'scale(1)';
              }, 1300 + i * 150);
            });
          });
        },
        { threshold: 0.25 },
      );
      observer.observe(svg);
    }
  }
</script>
