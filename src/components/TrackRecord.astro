---
// Track Record: zwei grosse Kacheln, darunter Reihen zu je vier.
// Startseite nutzt rows={1} (2+4), die About-Seite rows={2} (2+4+4).
import { Picture } from 'astro:assets';
import { showcase } from '../content/de/home';

interface Props {
  /** Kleine Zeile über dem Block */
  label?: string;
  /** Wie viele Viererreihen unter den beiden grossen Kacheln */
  rows?: number;
  /** Link auf die Projektübersicht anzeigen */
  showAll?: boolean;
}

const { label = showcase.trackRecordLabel, rows = 1, showAll = true } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/img/projects/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const imageFor = (file: string) =>
  file ? images[`../assets/img/projects/${file}`]?.default : undefined;

const gross = showcase.projects.filter((p) => p.featured);
const klein = showcase.projects.filter((p) => !p.featured).slice(0, rows * 4);
---

<div class="tr">
  {
    label && (
      <p class="tr-label" data-reveal>
        {label}
      </p>
    )
  }

  <!-- Zwei grosse Kacheln -->
  <ul class="tr-lead" data-reveal-group>
    {
      gross.map((project) => (
        <li>
          <a class="tr-card tr-card-lead" href={project.href} target="_blank" rel="noopener noreferrer">
            <span class="tr-thumb tr-thumb-lead">
              {imageFor(project.image) ? (
                <Picture
                  src={imageFor(project.image)!}
                  formats={['avif', 'webp']}
                  widths={[640, 1200]}
                  sizes="(min-width: 900px) 46vw, 92vw"
                  alt={`Projekt ${project.name} von Riegler & Partner`}
                  class="tr-img"
                  style={project.position ? `object-position: ${project.position}` : undefined}
                />
              ) : (
                <span class="tr-thumb-empty" aria-hidden="true" />
              )}
            </span>
            <span class="tr-name tr-name-lead">
              {project.name}
              <svg class="tr-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
                <path d="M7 17 17 7M9 7h8v8" />
              </svg>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <!-- Viererreihen -->
  <ul class="tr-grid" data-reveal-group>
    {
      klein.map((project) => (
        <li>
          <a class="tr-card" href={project.href} target="_blank" rel="noopener noreferrer">
            <span class="tr-thumb">
              {imageFor(project.image) ? (
                <Picture
                  src={imageFor(project.image)!}
                  formats={['avif', 'webp']}
                  widths={[320, 640]}
                  sizes="(min-width: 900px) 22vw, 45vw"
                  alt={`Projekt ${project.name} von Riegler & Partner`}
                  class="tr-img"
                  style={project.position ? `object-position: ${project.position}` : undefined}
                />
              ) : (
                <span class="tr-thumb-empty" aria-hidden="true" />
              )}
            </span>
            <span class="tr-name">
              {project.name}
              <svg class="tr-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
                <path d="M7 17 17 7M9 7h8v8" />
              </svg>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    showAll && (
      <a
        href={showcase.projectsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="tr-all"
        data-reveal
      >
        {showcase.allProjects}
        <span aria-hidden="true">→</span>
      </a>
    )
  }
</div>

<style>
  .tr-label {
    font-size: 0.6rem;
    letter-spacing: 0.24em;
    color: var(--color-text-dim);
  }

  .tr-lead,
  .tr-grid {
    display: grid;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tr-lead {
    gap: 1rem;
  }

  @media (min-width: 900px) {
    .tr-lead {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  .tr-grid {
    gap: 1rem;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 900px) {
    .tr-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .tr-card {
    display: block;
    text-decoration: none;
  }

  .tr-thumb {
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    aspect-ratio: 4 / 3;
  }

  /* Die beiden grossen Kacheln liegen breiter — sie tragen die Sektion. */
  .tr-thumb-lead {
    aspect-ratio: 16 / 10;
  }

  .tr-thumb :global(.tr-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* An die Bildwelt angeglichen: entsättigt und abgedunkelt, damit
       fremde Projektfotos nicht aus dem Look fallen. */
    filter: saturate(0.72) brightness(0.82) contrast(1.05);
    transition:
      filter 0.5s ease,
      transform 0.6s ease;
  }

  .tr-card:hover :global(.tr-img),
  .tr-card:focus-visible :global(.tr-img) {
    filter: saturate(0.95) brightness(0.95) contrast(1.02);
    transform: scale(1.03);
  }

  .tr-thumb-empty {
    display: block;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(80% 70% at 30% 25%, rgba(176, 141, 87, 0.18) 0%, rgba(18, 18, 16, 0) 70%),
      var(--color-surface);
  }

  .tr-name {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.85rem;
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--color-text-soft);
    transition: color 0.3s ease;
  }

  .tr-name-lead {
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .tr-card:hover .tr-name,
  .tr-card:focus-visible .tr-name {
    color: var(--color-gold-light);
  }

  .tr-arrow {
    width: 0.85rem;
    height: 0.85rem;
    flex-shrink: 0;
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  .tr-card:hover .tr-arrow,
  .tr-card:focus-visible .tr-arrow {
    opacity: 1;
  }

  .tr-all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    font-size: 0.75rem;
    color: var(--color-gold-light);
    transition: color 0.3s ease;
  }

  .tr-all:hover {
    color: var(--color-gold-bright);
  }
</style>
