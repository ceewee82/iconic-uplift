---
// Sektion 11 — Team-Teaser. Spec: DEV_SPEC §4 Zeile 11.
import { Picture } from 'astro:assets';
import { team } from '../content/de/home';

// Alle Teamfotos einsammeln, damit Astro sie im Build optimieren kann.
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/img/team/*.{jpg,jpeg,png,webp}',
  { eager: true },
);

const photoFor = (file: string) =>
  file ? photos[`../assets/img/team/${file}`]?.default : undefined;
---

<section id="team" class="border-b border-[var(--color-line)] bg-[var(--color-black)]">
  <div class="mx-auto max-w-[100rem] px-6 py-16 md:px-10 md:py-20">
    <p class="text-[0.65rem] tracking-[0.24em] text-[var(--color-gold)]" data-reveal>
      {team.eyebrow}
    </p>
    <h2
      class="mt-7 max-w-3xl text-3xl leading-[1.15] sm:text-4xl md:text-5xl"
      data-reveal
      data-reveal-delay="0.08"
    >
      {team.h2}
    </h2>

    <ul class="mt-12 grid gap-8 sm:grid-cols-3 md:mt-14 md:gap-10" data-reveal-group>
      {
        team.members.map((member) => {
          const photo = photoFor(member.photo);
          return (
            <li>
              <div class="portrait">
                {photo ? (
                  <Picture
                    src={photo}
                    formats={['avif', 'webp']}
                    widths={[400, Math.min(800, photo.width)]}
                    sizes="(min-width: 640px) 30vw, 90vw"
                    alt={`${member.name} — ${member.role}`}
                    class="portrait-img"
                  />
                ) : (
                  <span class="portrait-initials" aria-hidden="true">
                    {member.name
                      .split(' ')
                      .map((part) => part[0])
                      .join('')}
                  </span>
                )}
                <span class="portrait-vignette" aria-hidden="true" />
              </div>
              <h3 class="mt-6 font-[var(--font-display)] text-lg text-[var(--color-text)]">
                {member.name}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-soft)]">
                {member.role}
              </p>
            </li>
          );
        })
      }
    </ul>

    <div
      class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-[var(--color-line)] pt-8 md:mt-14"
      data-reveal
    >
      <span class="text-[0.6rem] tracking-[0.24em] text-[var(--color-text-dim)]">
        {team.poweredByLabel}
      </span>
      {
        team.poweredBy.map((brand) => (
          <a
            href={brand.href}
            target="_blank"
            rel="noopener noreferrer"
            class="font-[var(--font-display)] text-xs tracking-[0.12em] text-[var(--color-text-soft)] transition-colors hover:text-[var(--color-gold-light)]"
          >
            {brand.name}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .portrait {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    border: 1px solid var(--color-line);
    background:
      radial-gradient(80% 70% at 20% 30%, rgba(176, 141, 87, 0.16) 0%, rgba(18, 18, 16, 0) 70%),
      var(--color-surface);
  }

  /* Einheitlicher Schwarz-Weiß-Look nach dem Vorbild von Christians Foto:
     entsättigt, kontrastreicher, leicht abgedunkelt. Bewusst als CSS-Filter
     statt vorbearbeiteter Dateien — die Originale bleiben unangetastet und
     der Look lässt sich an einer einzigen Stelle nachjustieren. */
  .portrait :global(.portrait-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    filter: grayscale(1) contrast(1.2) brightness(0.8);
  }

  /* Nach außen dunkelnder Verlauf. Holt helle Büro-Hintergründe näher an
     den dunklen Studio-Grund von Christians Aufnahme heran — ersetzt aber
     keine echte Freistellung oder Retusche. */
  .portrait-vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(76% 60% at 50% 36%, rgba(11, 11, 12, 0) 0%, rgba(11, 11, 12, 0.75) 100%),
      linear-gradient(to bottom, rgba(11, 11, 12, 0.08) 0%, rgba(11, 11, 12, 0.6) 100%);
    pointer-events: none;
  }

  .portrait-initials {
    font-family: var(--font-display);
    font-size: 1.75rem;
    letter-spacing: 0.12em;
    color: var(--color-text-dim);
  }
</style>
