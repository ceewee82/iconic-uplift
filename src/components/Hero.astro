---
// Sektion 2 — Hero Before/After. Spec: DEV_SPEC §4 Zeile 2.
// Desktop: horizontaler Wipe, Start bei 50 %. Mobile: vertikaler Split.
// Auto-Demo beim Load einmal sanft 45 → 55 % (hinter prefers-reduced-motion).
import { Picture } from 'astro:assets';
import { hero } from '../content/de/home';
import { cta } from '../content/de/global';
import heroBefore from '../assets/img/hero-before.png';
import heroAfter from '../assets/img/hero-after.png';

// Quellmaterial ist 1024 px breit — grössere Breiten wären hochskaliert.
const widths = [640, 1024];
---

<section class="relative h-[100svh] min-h-[38rem] w-full overflow-hidden bg-[var(--color-black)]">
  <div
    id="hero-compare"
    class="absolute inset-0 select-none"
    data-orientation="horizontal"
    style="--split: 50"
  >
    <!-- Bestand (liegt unten, immer vollflächig) -->
    <Picture
      src={heroBefore}
      formats={['avif', 'webp']}
      widths={widths}
      sizes="100vw"
      alt={hero.altBefore}
      class="absolute inset-0 size-full object-cover"
      loading="eager"
      fetchpriority="high"
    />

    <!-- Sell-ready (darüber, per clip-path beschnitten) -->
    <div id="hero-after-clip" class="absolute inset-0">
      <Picture
        src={heroAfter}
        formats={['avif', 'webp']}
        widths={widths}
        sizes="100vw"
        alt={hero.altAfter}
        class="absolute inset-0 size-full object-cover"
        loading="eager"
      />
    </div>

    <!-- Abdunklung für Textkontrast (CLAUDE.md Regel 6) -->
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[color-mix(in_srgb,var(--color-black)_70%,transparent)] via-[color-mix(in_srgb,var(--color-black)_35%,transparent)] to-[color-mix(in_srgb,var(--color-black)_80%,transparent)]"
      aria-hidden="true"
    >
    </div>

    <!-- Tippfläche: setzt die Trennlinie per Tap/Klick. Bewusst ohne
         eigenes touch-action — ein Tap kollidiert nicht mit dem Scrollen. -->
    <div id="hero-surface" class="absolute inset-0"></div>

    <!-- Trennlinie und Griff. Der Griff ist das eigentliche Bedienelement:
         nur er trägt touch-action: none, damit Ziehen am Griff nicht als
         Seiten-Scroll interpretiert wird — der Rest des Heros bleibt
         normal scrollbar. -->
    <div id="hero-divider" class="absolute">
      <span class="hero-line" aria-hidden="true"></span>
      <button
        id="hero-handle"
        type="button"
        class="hero-handle"
        role="slider"
        aria-label={hero.a11ySlider}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
        aria-orientation="horizontal"
      >
        <span class="hero-handle-hit" aria-hidden="true"></span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
          <path class="hero-arrows-h" d="M9.5 8.5 6 12l3.5 3.5M14.5 8.5 18 12l-3.5 3.5" />
          <path class="hero-arrows-v" d="M8.5 9.5 12 6l3.5 3.5M8.5 14.5 12 18l3.5-3.5" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Labels -->
  <p
    class="pointer-events-none absolute top-28 left-6 text-[0.6rem] tracking-[0.22em] text-[var(--color-text-soft)] md:left-10 md:text-[0.65rem]"
  >
    {hero.labelBefore}
  </p>
  <!-- Mobil unter dem ersten Label statt daneben: Beide zusammen sind
       breiter als ein 375-px-Schirm und liefen ineinander. Untereinander
       passt es auch besser zum senkrechten Split (oben Bestand, unten
       sell-ready). Ab 768 px wieder rechts. -->
  <p
    class="pointer-events-none absolute top-[8.5rem] left-6 text-left text-[0.6rem] tracking-[0.22em] text-[var(--color-gold-light)] md:top-28 md:right-10 md:left-auto md:text-right md:text-[0.65rem]"
  >
    {hero.labelAfter}
  </p>

  <!-- Headline-Block -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 flex flex-col items-center px-6 pb-24 text-center md:pb-28"
  >
    <h1 class="max-w-3xl text-4xl leading-[1.08] sm:text-5xl md:text-6xl">
      {hero.h1}
    </h1>
    <p class="mt-6 max-w-xl text-sm text-[var(--color-text-soft)] md:text-base">
      {hero.sub}
    </p>
    <div class="pointer-events-auto mt-9 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#investor-pack"
        class="border border-[var(--color-gold)] bg-[var(--color-gold)] px-7 py-3.5 text-xs tracking-[0.12em] text-[var(--color-black)] uppercase transition-colors duration-300 hover:bg-[var(--color-gold-light)]"
      >
        {cta.primary}
      </a>
      <a
        href="#deal"
        class="border border-[var(--color-line)] px-7 py-3.5 text-xs tracking-[0.12em] text-[var(--color-text-soft)] uppercase transition-colors duration-300 hover:border-[var(--color-gold)] hover:text-[var(--color-text)]"
      >
        {cta.secondary}
      </a>
    </div>
  </div>

  <p
    class="pointer-events-none absolute bottom-8 left-1/2 -translate-x-1/2 text-[0.6rem] tracking-[0.3em] text-[var(--color-text-dim)]"
  >
    {hero.scroll}
  </p>
</section>

<style>
  /* Trennlinie und Griff folgen --split; Ausrichtung schaltet über
     data-orientation am Container um (Desktop horizontal, Mobile vertikal). */
  #hero-divider {
    color: var(--color-gold-light);
    pointer-events: none; /* nur der Griff darin ist bedienbar */
  }

  .hero-handle {
    pointer-events: auto;
  }

  .hero-line {
    position: absolute;
    background: var(--color-gold);
  }

  .hero-handle {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin: -1.5rem 0 0 -1.5rem;
    padding: 0;
    border: 1px solid var(--color-gold);
    border-radius: 9999px; /* Kreis — einzige erlaubte Rundung (CLAUDE.md) */
    background: rgba(11, 11, 12, 0.55); /* --black auf 55 % */
    backdrop-filter: blur(4px);
    color: var(--color-gold-light);
    cursor: grab;
    /* Entscheidend fuer Mobil: Der Browser darf Gesten auf dem Griff nicht
       als Scrollen deuten, sonst bricht er den Drag sofort ab. Gilt nur
       hier — der uebrige Hero bleibt scrollbar. */
    touch-action: none;
  }

  .hero-handle:active {
    cursor: grabbing;
  }

  /* Unsichtbare Vergroesserung der Trefferflaeche auf 4,25 rem (68 px),
     deutlich ueber der 44-px-Empfehlung fuer Touch-Ziele. */
  .hero-handle-hit {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4.25rem;
    height: 4.25rem;
    transform: translate(-50%, -50%);
    border-radius: 9999px;
  }

  /* Sanfter Puls, solange der Griff noch nicht angefasst wurde — macht
     mobil sichtbar, dass hier etwas zu bedienen ist. */
  .hero-handle::after {
    content: '';
    position: absolute;
    inset: -0.5rem;
    border: 1px solid var(--color-gold);
    border-radius: 9999px;
    opacity: 0;
    animation: hero-handle-pulse 2.8s ease-out infinite;
  }

  .hero-handle[data-touched='true']::after {
    animation: none;
  }

  @keyframes hero-handle-pulse {
    0% { opacity: 0.5; transform: scale(0.92); }
    70% { opacity: 0; transform: scale(1.18); }
    100% { opacity: 0; transform: scale(1.18); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-handle::after {
      animation: none;
    }
  }

  .hero-handle svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  /* Horizontal: Linie senkrecht, Griff auf halber Höhe */
  [data-orientation='horizontal'] #hero-after-clip {
    clip-path: inset(0 0 0 calc(var(--split) * 1%));
  }
  [data-orientation='horizontal'] #hero-divider {
    inset: 0 auto 0 calc(var(--split) * 1%);
  }
  [data-orientation='horizontal'] .hero-line {
    inset: 0 auto 0 0;
    width: 1px;
  }
  [data-orientation='horizontal'] .hero-handle {
    top: 50%;
    left: 0;
  }
  [data-orientation='horizontal'] .hero-arrows-v {
    display: none;
  }

  /* Vertikal: Linie waagerecht, Griff auf halber Breite */
  [data-orientation='vertical'] #hero-after-clip {
    clip-path: inset(calc(var(--split) * 1%) 0 0 0);
  }
  [data-orientation='vertical'] #hero-divider {
    inset: calc(var(--split) * 1%) 0 auto 0;
  }
  [data-orientation='vertical'] .hero-line {
    inset: 0 0 auto 0;
    height: 1px;
  }
  /* Mobil aus der Textmitte gerückt: mittig läge der Griff genau auf der
     Headline. Bei 78 % bleibt er gut erreichbar und der Text frei. */
  [data-orientation='vertical'] .hero-handle {
    top: 0;
    left: 78%;
  }
  [data-orientation='vertical'] .hero-arrows-h {
    display: none;
  }
  [data-orientation='vertical'] .hero-handle {
    cursor: grab;
  }
</style>

<script>
  const compare = document.getElementById('hero-compare')!;
  const handle = document.getElementById('hero-handle')!;
  const surface = document.getElementById('hero-surface')!;

  const clamp = (n: number) => Math.min(100, Math.max(0, n));

  let split = 50;
  const setSplit = (next: number) => {
    split = clamp(next);
    compare.style.setProperty('--split', String(split));
    handle.setAttribute('aria-valuenow', String(Math.round(split)));
  };

  /** Puls am Griff verstummt, sobald jemand ihn bedient hat. */
  const markTouched = () => {
    handle.dataset.touched = 'true';
  };

  // --- Ausrichtung: Mobile (< 768 px) vertikal, darüber horizontal ---
  const mq = window.matchMedia('(min-width: 768px)');
  const syncOrientation = () => {
    const horizontal = mq.matches;
    compare.dataset.orientation = horizontal ? 'horizontal' : 'vertical';
    handle.setAttribute('aria-orientation', horizontal ? 'horizontal' : 'vertical');
  };
  syncOrientation();
  mq.addEventListener('change', syncOrientation);

  const positionFromEvent = (event: PointerEvent) => {
    const rect = compare.getBoundingClientRect();
    return mq.matches
      ? ((event.clientX - rect.left) / rect.width) * 100
      : ((event.clientY - rect.top) / rect.height) * 100;
  };

  // --- Ziehen am Griff -------------------------------------------------
  // Nur der Griff zieht. Er trägt touch-action: none, deshalb bricht der
  // Browser die Geste nicht als Scroll ab. Der übrige Hero bleibt damit
  // auf dem Handy normal scrollbar — vorher lag ein bildschirmfüllendes
  // Ziehfeld darüber, das jeden vertikalen Wisch abfing und verlor.
  let dragging = false;

  /** Zeigerfang ist eine Bequemlichkeit, kein Muss — nie den Ablauf blockieren. */
  const fangen = (el: Element, id: number) => {
    try {
      el.setPointerCapture(id);
    } catch {
      /* manche Zeiger lassen sich nicht fangen; Ziehen funktioniert trotzdem */
    }
  };

  handle.addEventListener('pointerdown', (event) => {
    dragging = true;
    stopDemo();
    markTouched();
    fangen(handle, event.pointerId);
  });

  handle.addEventListener('pointermove', (event) => {
    if (!dragging) return;
    event.preventDefault();
    setSplit(positionFromEvent(event));
  });

  const endDrag = (event: PointerEvent) => {
    if (!dragging) return;
    dragging = false;
    try {
      handle.releasePointerCapture(event.pointerId);
    } catch {
      /* war nie gefangen */
    }
  };
  handle.addEventListener('pointerup', endDrag);
  handle.addEventListener('pointercancel', endDrag);

  // --- Tippen auf die Fläche -------------------------------------------
  // Zweiter Weg zur Bedienung: Ein Tap springt zur getippten Position.
  // Ein Tap ist keine Wischgeste und kollidiert daher nicht mit dem Scrollen.
  let downAt: { x: number; y: number } | null = null;

  surface.addEventListener('pointerdown', (event) => {
    downAt = { x: event.clientX, y: event.clientY };
    // Auf dem Desktop bleibt das gewohnte Ziehen über die ganze Fläche.
    if (event.pointerType === 'mouse') {
      dragging = true;
      stopDemo();
      markTouched();
      // Erst den Wert setzen, dann fangen — sonst verschluckt ein
      // fehlgeschlagener Zeigerfang den ersten Sprung.
      setSplit(positionFromEvent(event));
      fangen(surface, event.pointerId);
    }
  });

  surface.addEventListener('pointermove', (event) => {
    if (!dragging || event.pointerType !== 'mouse') return;
    setSplit(positionFromEvent(event));
  });

  surface.addEventListener('pointerup', (event) => {
    if (event.pointerType === 'mouse') {
      dragging = false;
      try {
        surface.releasePointerCapture(event.pointerId);
      } catch {
        /* war nie gefangen */
      }
      downAt = null;
      return;
    }

    // Touch/Pen: nur als Tap werten, wenn der Finger kaum gewandert ist —
    // sonst war es ein Scrollversuch und wir mischen uns nicht ein.
    if (!downAt) return;
    const gewandert = Math.hypot(event.clientX - downAt.x, event.clientY - downAt.y);
    downAt = null;
    if (gewandert > 12) return;

    stopDemo();
    markTouched();
    setSplit(positionFromEvent(event));
  });

  surface.addEventListener('pointercancel', () => {
    downAt = null;
    dragging = false;
  });

  // --- Tastatur ---------------------------------------------------------
  handle.addEventListener('keydown', (event) => {
    const step = event.shiftKey ? 10 : 2;
    const keys: Record<string, number> = {
      ArrowLeft: -step,
      ArrowDown: -step,
      ArrowRight: step,
      ArrowUp: step,
    };
    if (event.key in keys) {
      event.preventDefault();
      stopDemo();
      markTouched();
      setSplit(split + keys[event.key]);
    } else if (event.key === 'Home') {
      event.preventDefault();
      stopDemo();
      markTouched();
      setSplit(0);
    } else if (event.key === 'End') {
      event.preventDefault();
      stopDemo();
      markTouched();
      setSplit(100);
    }
  });

  // --- Auto-Demo: einmal sanft 45 → 55 → 50, damit die Geste erkennbar wird ---
  let demoFrame = 0;
  const stopDemo = () => {
    if (demoFrame) cancelAnimationFrame(demoFrame);
    demoFrame = 0;
  };

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const runDemo = () => {
    if (reduceMotion.matches) return;
    const DURATION = 2200;
    const start = performance.now();
    const tick = (now: number) => {
      const t = Math.min(1, (now - start) / DURATION);
      // ein voller Sinus-Durchlauf: 50 → 45 → 55 → 50
      const eased = Math.sin(t * Math.PI * 2);
      setSplit(50 - eased * 5);
      if (t < 1) {
        demoFrame = requestAnimationFrame(tick);
      } else {
        setSplit(50);
        demoFrame = 0;
      }
    };
    demoFrame = requestAnimationFrame(tick);
  };

  // Erst starten, wenn beide Bilder stehen — sonst läuft die Demo ins Leere.
  if (document.readyState === 'complete') {
    setTimeout(runDemo, 600);
  } else {
    window.addEventListener('load', () => setTimeout(runDemo, 600), { once: true });
  }
</script>
