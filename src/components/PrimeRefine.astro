---
// Sektion 5 — PrimeRefine. Spec: DEV_SPEC §4 Zeile 5.
// Desktop: fünf Schritte waagerecht, Verbindungslinie zeichnet sich beim
// Scrollen. Mobil: senkrechte Timeline. Schritt 5 ist goldgefüllt.
import { primeRefine } from '../content/de/home';

const lastIndex = primeRefine.steps.length - 1;
---

<section id="process" class="border-b border-[var(--color-line)] bg-[var(--color-black)]">
  <div class="mx-auto max-w-[100rem] px-6 py-16 md:px-10 md:py-20">
    <p class="text-[0.65rem] tracking-[0.24em] text-[var(--color-gold)]" data-reveal>
      {primeRefine.eyebrow}
    </p>

    <h2
      class="mt-7 max-w-3xl text-3xl leading-[1.15] sm:text-4xl md:text-5xl"
      data-reveal
      data-reveal-delay="0.08"
    >
      {primeRefine.h2}
    </h2>

    <!-- Schritt-Kette -->
    <div class="steps mt-14 md:mt-16" data-draw-scope>
      <!-- Schiene, auf der die Marker sitzen -->
      <div class="rail" aria-hidden="true">
        <span class="rail-base"></span>
        <span class="rail-progress" data-draw></span>
      </div>

      <ol class="steps-grid">
        {
          primeRefine.steps.map((step, i) => (
            <li class="step" data-reveal data-reveal-delay={String(0.08 * i)}>
              <span class:list={['marker', i === lastIndex && 'marker-final']}>
                <span class="marker-dot" />
              </span>
              <p class="step-index">{String(i + 1).padStart(2, '0')}</p>
              <h3 class:list={['step-title', i === lastIndex && 'step-title-final']}>
                {step.title}
              </h3>
              <p class="step-text">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Fußzeile -->
    <ul
      class="mt-14 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-[var(--color-line)] pt-8 text-xs text-[var(--color-text-dim)] md:mt-16"
      data-reveal
    >
      {
        primeRefine.footer.map((item, i) => (
          <li class="flex items-center gap-8">
            {i > 0 && <span class="size-1 rounded-full bg-[var(--color-line)]" aria-hidden="true" />}
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .steps {
    position: relative;
  }

  /* ---------- Mobil: senkrechte Timeline ---------- */
  .rail {
    position: absolute;
    top: 0.375rem;
    bottom: 0.375rem;
    left: 0.375rem;
    width: 1px;
  }

  .rail-base,
  .rail-progress {
    position: absolute;
    inset: 0;
  }

  .rail-base {
    background: var(--color-line);
  }

  .rail-progress {
    background: var(--color-gold);
  }

  .steps-grid {
    display: grid;
    gap: 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    position: relative;
    padding-left: 2.5rem;
  }

  .marker {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 0.75rem;
    height: 0.75rem;
    border: 1px solid var(--color-gold);
    border-radius: 9999px; /* Kreis — die einzige erlaubte Rundung */
    background: var(--color-black);
  }

  .marker-dot {
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 9999px;
    background: transparent;
  }

  /* Schritt 5 goldgefüllt (DEV_SPEC §4) */
  .marker-final {
    background: var(--color-gold);
  }

  .step-index {
    font-family: var(--font-display);
    font-size: 0.7rem;
    color: var(--color-text-dim);
  }

  .step-title {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    color: var(--color-text);
  }

  .step-title-final {
    color: var(--color-gold-light);
  }

  .step-text {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text-soft);
  }

  /* ---------- Desktop: fünf Schritte waagerecht ---------- */
  @media (min-width: 768px) {
    .rail {
      top: 0.375rem;
      right: 0;
      bottom: auto;
      left: 0;
      width: auto;
      height: 1px;
    }

    .steps-grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 2rem;
    }

    .step {
      padding-top: 2.75rem;
      padding-left: 0;
    }

    .marker {
      top: 0;
      left: 0;
    }

    .step-text {
      max-width: 15rem;
    }
  }
</style>
