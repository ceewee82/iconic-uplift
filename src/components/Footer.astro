---
// Sektion 13 — Footer. Spec: DEV_SPEC §4 Zeile 13, Copy aus §0.
// Der Disclaimer steht laut CLAUDE.md Regel 1 auf jeder Seite.
import { brand, nav, legal } from '../content/de/global';
---

<footer class="bg-[var(--color-black)]">
  <div class="mx-auto max-w-[100rem] px-6 py-16 md:px-10 md:py-20">
    <div class="grid gap-12 md:grid-cols-[1fr_auto_auto_auto] md:gap-16">
      <div>
        <p class="font-[var(--font-display)] text-sm tracking-[0.22em] text-[var(--color-text)]">
          {brand.wordmark}
        </p>
        <p class="endorsement mt-4 text-[0.6rem]">{brand.endorsement}</p>
      </div>

      <div>
        <p class="text-[0.6rem] tracking-[0.24em] text-[var(--color-text-dim)]">SEITEN</p>
        <ul class="mt-5 space-y-2.5">
          {
            nav.overlay.seiten.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-[var(--color-text-soft)] transition-colors hover:text-[var(--color-text)]"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-[0.6rem] tracking-[0.24em] text-[var(--color-text-dim)]">MEHR</p>
        <ul class="mt-5 space-y-2.5">
          {
            nav.overlay.mehr.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-[var(--color-text-soft)] transition-colors hover:text-[var(--color-text)]"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="flex items-center gap-2 pt-1 text-xs">
            {
              nav.langs.map((lang, i) => (
                <>
                  {i > 0 && <span class="text-[var(--color-text-dim)]">·</span>}
                  <a
                    href={lang.href}
                    aria-current={lang.active ? 'true' : undefined}
                    class:list={[
                      'transition-colors',
                      lang.active
                        ? 'text-[var(--color-text)]'
                        : 'text-[var(--color-text-dim)] hover:text-[var(--color-text-soft)]',
                    ]}
                  >
                    {lang.label}
                  </a>
                </>
              ))
            }
          </li>
        </ul>
      </div>

      <div>
        <p class="text-[0.6rem] tracking-[0.24em] text-[var(--color-text-dim)]">SOCIAL</p>
        <ul class="mt-5 space-y-2.5">
          {
            nav.overlay.social.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-[var(--color-text-soft)] transition-colors hover:text-[var(--color-text)]"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Rechtszeile -->
    <div
      class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-[var(--color-line)] pt-8"
    >
      <p class="text-xs text-[var(--color-text-dim)]">{legal.copyright}</p>
      <ul class="flex gap-6">
        <li>
          <a
            href="/impressum"
            class="text-xs text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text-soft)]"
          >
            Impressum
          </a>
        </li>
        <li>
          <a
            href="/datenschutz"
            class="text-xs text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-text-soft)]"
          >
            Datenschutz
          </a>
        </li>
      </ul>
    </div>

    <p class="mt-8 max-w-3xl text-xs leading-relaxed text-[var(--color-text-dim)]">
      {legal.disclaimer}
    </p>
  </div>
</footer>
