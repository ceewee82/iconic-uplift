---
// Unterseite Tiers — Copy: docs/website-copy-de.md §5
import Page from '../layouts/Page.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { tiersPage } from '../content/de/pages';
---

<Page title={tiersPage.seo.title} description={tiersPage.seo.description}>
  <PageHero {...tiersPage.hero} />

  <!-- 5.2 Tier-Detailkarten -->
  <section class="border-b border-[var(--color-line)] bg-[var(--color-black)]">
    <div class="mx-auto max-w-[100rem] px-6 py-16 md:px-10 md:py-20">
      <ul class="tier-cards" data-reveal-group>
        {
          tiersPage.details.map((tier) => (
            <li class:list={['tier-card', tier.featured && 'tier-card-featured']}>
              <h2 class:list={['tier-name', tier.featured && 'tier-name-featured']}>{tier.name}</h2>
              <p class="tier-claim">{tier.claim}</p>

              <dl class="tier-facts">
                <dt>Typische Lage</dt>
                <dd>{tier.location}</dd>
                <dt>Umfang</dt>
                <dd>{tier.scope}</dd>
                <dt>Zielkäufer</dt>
                <dd>{tier.buyer}</dd>
              </dl>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5.3 Vergleichstabelle -->
  <section class="border-b border-[var(--color-line)] bg-[var(--color-black)]">
    <div class="mx-auto max-w-[100rem] px-6 py-16 md:px-10 md:py-20">
      <h2 class="text-3xl leading-[1.15] sm:text-4xl" data-reveal>
        {tiersPage.comparison.h2}
      </h2>

      <div class="table-scroll mt-12" data-reveal>
        <table class="cmp">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Merkmal</span></th>
              <th scope="col">PRIME</th>
              <th scope="col" class="cmp-featured">SIGNATURE</th>
              <th scope="col">ICONIC</th>
            </tr>
          </thead>
          <tbody>
            {
              tiersPage.comparison.rows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td>{row.prime}</td>
                  <td class="cmp-featured">{row.signature}</td>
                  <td>{row.iconic}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 5.4 CTA -->
  <CtaBand h2={tiersPage.cta} secondary="call" />
</Page>

<style>
  .tier-cards {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .tier-cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tier-card {
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 2.5rem 2rem;
  }

  .tier-card-featured {
    border-color: var(--color-gold);
    background: #161613;
  }

  .tier-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.14em;
    color: var(--color-text);
  }

  .tier-name-featured {
    color: var(--color-gold-light);
  }

  .tier-claim {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--color-text);
  }

  .tier-facts {
    margin: 2rem 0 0;
  }

  .tier-facts dt {
    margin-top: 1.5rem;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .tier-facts dt:first-child {
    margin-top: 0;
  }

  .tier-facts dd {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text-soft);
  }

  /* Tabelle scrollt in sich, damit die Seite nicht waagerecht wandert */
  .table-scroll {
    overflow-x: auto;
  }

  .cmp {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    text-align: left;
  }

  .cmp th,
  .cmp td {
    border-bottom: 1px solid var(--color-line);
    padding: 1rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 400;
  }

  .cmp thead th {
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--color-text-dim);
  }

  .cmp tbody th {
    font-family: var(--font-display);
    color: var(--color-text);
  }

  .cmp td {
    color: var(--color-text-soft);
  }

  .cmp .cmp-featured {
    background: #161613;
    color: var(--color-text);
  }

  .cmp thead .cmp-featured {
    color: var(--color-gold-light);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
