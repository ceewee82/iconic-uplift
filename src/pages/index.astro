---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import PrimeRefine from '../components/PrimeRefine.astro';
import DualTrack from '../components/DualTrack.astro';
import Tiers from '../components/Tiers.astro';
import Showcase from '../components/Showcase.astro';
import Timelapse from '../components/Timelapse.astro';
import Economics from '../components/Economics.astro';
import Regions from '../components/Regions.astro';
import Team from '../components/Team.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import { seo, trustBar } from '../content/de/home';
import { brand } from '../content/de/global';
---

<Base title={seo.title} description={seo.description}>
  <Nav />

  <main>
    <!-- 2 · Hero Before/After -->
    <Hero />

    <!-- 3 · Trust Bar (statisch, DEV_SPEC §4 Zeile 3) -->
    <section class="border-y border-[var(--color-line)] bg-[var(--color-black)]">
      <div
        class="mx-auto flex max-w-[100rem] flex-wrap items-center justify-center gap-x-10 gap-y-4 px-6 py-7 md:px-10"
      >
        <span class="endorsement text-[0.65rem]">{brand.endorsement}</span>
        {
          trustBar.map((item) => (
            <span class="flex items-center gap-10 text-xs text-[var(--color-text-soft)]">
              <span class="hidden h-3 w-px bg-[var(--color-line)] md:block" aria-hidden="true" />
              {item}
            </span>
          ))
        }
      </div>
    </section>

    <!-- 4 · Problem -->
    <Problem />

    <!-- 5 · PrimeRefine -->
    <PrimeRefine />

    <!-- 6 · Dual Track -->
    <DualTrack />

    <!-- 7 · Tiers -->
    <Tiers />

    <!-- 8 · Showcase / VR -->
    <Showcase />

    <!-- 8b · Construction Timelapse -->
    <Timelapse />

    <!-- 9 · Economics -->
    <Economics />

    <!-- 10 · Zielgebiete -->
    <Regions />

    <!-- 11 · Team -->
    <Team />

    <!-- 12 · Final CTA -->
    <FinalCta />
  </main>

  <!-- 13 · Footer -->
  <Footer />
</Base>
