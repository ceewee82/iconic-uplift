---
// Unterseite Investors — Copy: docs/website-copy-de.md §2
import Page from '../layouts/Page.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { investors } from '../content/de/pages';
import { legal } from '../content/de/global';
---

<Page title={investors.seo.title} description={investors.seo.description}>
  <PageHero {...investors.hero} />

  <!-- 2.2 Warum Bestandsvillen, warum jetzt -->
  <section class="border-b border-[var(--color-line)] bg-[var(--color-black)]">
    <div class="mx-auto max-w-[100rem] px-6 py-16 md:px-10 md:py-20">
      <div class="grid gap-14 lg:grid-cols-[42fr_58fr] lg:gap-20">
        <h2 class="text-3xl leading-[1.15] sm:text-4xl" data-reveal>
          {investors.market.h2}
        </h2>
        <div>
          <p
            class="max-w-2xl text-base leading-relaxed text-[var(--color-text-soft)]"
            data-reveal
            data-reveal-delay="0.08"
          >
            {investors.market.body}
          </p>
          <ul class="mt-12 grid gap-px bg-[var(--color-line)] sm:grid-cols-3" data-reveal-group>
            {
              investors.market.points.map((point) => (
                <li class="bg-[var(--color-surface)] p-6">
                  <h3 class="font-[var(--font-display)] text-base text-[var(--color-text)]">
                    {point.title}
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-soft)]">
                    {point.text}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2.3 Das Sicherheits-Setup -->
  <section class="border-b border-[var(--color-line)] bg-[var(--color-black)]">
    <div class="mx-auto max-w-[100rem] px-6 py-16 md:px-10 md:py-20">
      <h2 class="max-w-3xl text-3xl leading-[1.15] sm:text-4xl md:text-5xl" data-reveal>
        {investors.safety.h2}
      </h2>
      <ol class="mt-14 grid gap-px bg-[var(--color-line)] sm:grid-cols-2" data-reveal-group>
        {
          investors.safety.items.map((item, i) => (
            <li class="bg-[var(--color-surface)] p-8 md:p-10">
              <span class="font-[var(--font-display)] text-[0.7rem] text-[var(--color-gold)]">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-5 font-[var(--font-display)] text-xl">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-soft)]">
                {item.text}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 2.4 Ablauf für Investoren -->
  <section class="border-b border-[var(--color-line)] bg-[var(--color-black)]">
    <div class="mx-auto max-w-[100rem] px-6 py-16 md:px-10 md:py-20">
      <h2 class="max-w-3xl text-3xl leading-[1.15] sm:text-4xl md:text-5xl" data-reveal>
        {investors.journey.h2}
      </h2>
      <ol class="journey mt-14" data-reveal-group>
        {
          investors.journey.steps.map((step, i) => (
            <li class="journey-step">
              <span class="journey-no">{String(i + 1).padStart(2, '0')}</span>
              <span class="journey-text">{step}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 2.5 FAQ -->
  <section class="border-b border-[var(--color-line)] bg-[var(--color-black)]">
    <div class="mx-auto max-w-[100rem] px-6 py-16 md:px-10 md:py-20">
      <h2 class="text-3xl leading-[1.15] sm:text-4xl" data-reveal>{investors.faq.h2}</h2>
      <dl class="mt-12 max-w-4xl" data-reveal-group>
        {
          investors.faq.items.map((item) => (
            <div class="faq-row">
              <dt class="faq-q">{item.q}</dt>
              <dd class="faq-a">{item.a}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-12 max-w-3xl text-xs leading-relaxed text-[var(--color-text-dim)]">
        {legal.disclaimer}
      </p>
    </div>
  </section>

  <!-- 2.6 Final CTA — laut Copy identisch Home 1.12 plus Assessment Call -->
  <CtaBand
    h2="Das Investor Pack. Zahlen, Szenarien, Prozess."
    body="Deal-Band, konservative Szenario-Rechnungen, Reporting-Beispiel und die PrimeRefine-Methodik — kuratiert als PDF, persönlich nachgefasst."
    secondary="call"
  />
</Page>

<style>
  .journey {
    display: grid;
    gap: 1px;
    margin: 3.5rem 0 0;
    padding: 0;
    background: var(--color-line);
    list-style: none;
  }

  .journey-step {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 1.5rem;
    background: var(--color-surface);
    padding: 1.5rem 1.75rem;
  }

  @media (min-width: 768px) {
    .journey-step {
      padding: 1.75rem 2.25rem;
      gap: 2.5rem;
    }
  }

  .journey-no {
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: var(--color-gold);
  }

  .journey-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-soft);
  }

  .faq-row {
    border-top: 1px solid var(--color-line);
    padding: 1.75rem 0;
  }

  .faq-row:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .faq-q {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .faq-a {
    margin: 0.75rem 0 0;
    max-width: 46rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text-soft);
  }
</style>
